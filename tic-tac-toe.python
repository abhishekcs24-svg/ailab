# AI Based Tic-Tac-Toe using Minimax

board = [" " for _ in range(9)]

HUMAN = "X"
AI = "O"


# Display the board
def display_board():
    print()
    print(board[0], "|", board[1], "|", board[2])
    print("--+---+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+---+--")
    print(board[6], "|", board[7], "|", board[8])
    print()


# Check winner
def check_winner(player):

    winning_positions = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in winning_positions:

        if board[a] == player and \
           board[b] == player and \
           board[c] == player:

            return True

    return False


# Check whether board is full
def is_full():
    return " " not in board


# Minimax algorithm
def minimax(is_maximizing):

    # AI wins
    if check_winner(AI):
        return 1

    # Human wins
    if check_winner(HUMAN):
        return -1

    # Draw
    if is_full():
        return 0

    if is_maximizing:

        best_score = -float("inf")

        for i in range(9):

            if board[i] == " ":

                board[i] = AI

                score = minimax(False)

                board[i] = " "

                best_score = max(best_score, score)

        return best_score

    else:

        best_score = float("inf")

        for i in range(9):

            if board[i] == " ":

                board[i] = HUMAN

                score = minimax(True)

                board[i] = " "

                best_score = min(best_score, score)

        return best_score


# Find the best move for AI
def best_move():

    best_score = -float("inf")
    move = -1

    for i in range(9):

        if board[i] == " ":

            board[i] = AI

            score = minimax(False)

            board[i] = " "

            if score > best_score:
                best_score = score
                move = i

    return move


# Main game
def play_game():

    print("AI BASED TIC-TAC-TOE")
    print("You = X")
    print("AI = O")

    while True:

        display_board()

        # Human move
        position = int(input("Enter your position (1-9): ")) - 1

        if position < 0 or position > 8:
            print("Invalid position!")
            continue

        if board[position] != " ":
            print("Position already occupied!")
            continue

        board[position] = HUMAN

        # Check human win
        if check_winner(HUMAN):
            display_board()
            print("You Win!")
            break

        # Check draw
        if is_full():
            display_board()
            print("Game Draw!")
            break

        # AI move
        move = best_move()
        board[move] = AI

        print("AI chose position:", move + 1)

        # Check AI win
        if check_winner(AI):
            display_board()
            print("AI Wins!")
            break

        # Check draw
        if is_full():
            display_board()
            print("Game Draw!")
            break


play_game()
